# Databricks Asset Bundle files
# databricks.yml is committed (static config, placeholder-free). Per-workspace
# values come from .databricks/bundle/<target>/variable-overrides.json, which is
# gitignored below. NEVER commit real workspace host / catalog / schema / warehouse.
.databricks/
databricks.yml.template
# CLI-generated deploy state -- contains workspace-specific resource IDs.
.databricks-resources.json
# Variable overrides hold real workspace values. The auto-loaded path lives under
# .databricks/ (already ignored); this also catches a stray repo-root copy.
# The placeholder example file IS committed.
variable-overrides.json
!variable-overrides.example.json

# IDE files
.vscode/
.idea/
.cursor/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
/dist/
build/
.venv/
venv/
ENV/

# uv.lock is NOT committed: local resolution goes through an internal package
# proxy that gets recorded in the lockfile. Users resolve from pyproject.toml.
uv.lock

# Testing
.pytest_cache/
.coverage
htmlcov/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Environment files
*.env
!example.env
.env.local

# Downloaded benchmark logs
benchmark_results/

# Internal roadmap (not for public distribution)
ROADMAP.md

# Frontend build artifacts
apps/dbxredact-app/node_modules/
apps/dbxredact-app/src/node_modules/

.ai-dev-kit/
.github/skills/

# Internal dev notes
.dev/

# Isaac Review tooling artifacts
.isaac/